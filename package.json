{
  "name": "@red-cup-engineering/web-theming-service",
  "version": "0.0.8",
  "type": "module",
  "description": "Derives light/dark CSS custom-property palettes and a shared stylesheet from design tokens, with numerical checks of specified token-pair contrast and color scarcity.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-serialized-content-engineering-services-section.git",
    "directory": "services/css-services-section/services/web-theming-service"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "for f in $(find src -name '*.mjs'); do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "src",
    "package.json",
    "README.md"
  ],
  "exports": {
    "./theming": "./src/theming/index.mjs",
    "./theming-computer": {
      "types": "./src/theming-computer/index.d.mts",
      "default": "./src/theming-computer/index.mjs"
    },
    "./package.json": "./package.json",
    "./themed-page": "./src/themed-page.mjs",
    "./design-tokens": "./src/theming-computer/design-tokens.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/metrologic": "0.4.0",
    "@red-cup-engineering/computer-data-engineering-services-section": "0.2.0",
    "@red-cup-engineering/xml-document-rendering-service": "0.1.7",
    "@red-cup-engineering/signcell": "0.2.0",
    "@red-cup-engineering/css-services-section": "0.1.4",
    "@red-cup-engineering/html-engineering-services-section": "0.1.3",
    "@red-cup-engineering/html-structural-projection-service": "0.3.3"
  },
  "sideEffects": false,
  "private": false
}
